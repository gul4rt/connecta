# Copie para .env (não versionado) e ajuste os valores.
# Em produção, use as variáveis de ambiente da plataforma.

# Conexão com o banco (JDBC)
DB_URL=jdbc:postgresql://localhost:5432/connecta
DB_USER=connecta
DB_PASSWORD=connecta

# Porta do servidor web
PORT=7000

# Limiares da lacuna na home ("Muita procura" / "Procura média")
CONNECTA_GAP_MUITA=5
CONNECTA_GAP_MEDIA=2

# dev (padrão: mostra /design) ou prod
CONNECTA_ENV=dev
